{
  "id": "seoul_flood_3d",
  "description": "서울 침수흔적 3D 건물 속성 명세. 실제 값은 FlatGeobuf와 GLB 속성표에 들어감",
  "classes": {
    "building": {
      "description": "건물 1동 = 속성표 1줄",
      "properties": {
        "buildingId": {
          "type": "STRING",
          "description": "원본 건물 번호(A1 GIS건물통합식별번호). 원본 데이터와 다시 맞춰볼 때 씀"
        },
        "floodYears": {
          "type": "SCALAR",
          "componentType": "UINT16",
          "description": "침수 이력. 자리 번호 = 연도 - 2010. 예: 2022년만 잠김 = 4096"
        },
        "grndFlr": {
          "type": "SCALAR",
          "componentType": "UINT8",
          "description": "지상층수(A26). 상세 패널"
        },
        "ugrndFlr": {
          "type": "SCALAR",
          "componentType": "UINT8",
          "description": "지하층수(A27, 건축물대장 기준). 셰이더 후보 판정 + 상세 패널"
        },
        "usage": {
          "type": "STRING",
          "description": "용도코드(A8, 대분류). 상세 패널"
        },
        "isResidential": {
          "type": "BOOLEAN",
          "description": "단독주택 01000 또는 지상 1~4층 공동주택 02000. 셰이더 후보 판정"
        },
        "height": {
          "type": "SCALAR",
          "componentType": "FLOAT32",
          "description": "돌출 높이(m). 원본 → 지상층수 × 3.25 → 3.25"
        },
        "heightSource": {
          "type": "ENUM",
          "enumType": "heightSource",
          "description": "높이를 어디서 얻었나. DEFAULT면 후보 제외 + 상세 패널에 높이 정보 없음"
        }
      }
    }
  },
  "enums": {
    "heightSource": {
      "valueType": "UINT8",
      "values": [
        { "name": "ORIGINAL", "value": 0, "description": "원본 높이(A16)" },
        {
          "name": "FROM_FLOORS",
          "value": 1,
          "description": "지상층수 × 3.25m"
        },
        {
          "name": "DEFAULT",
          "value": 2,
          "description": "정보 없음, 3.25m(1층)"
        }
      ]
    }
  }
}
